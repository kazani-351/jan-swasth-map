# Copy to .dev.vars (local) or set via `wrangler secret put` (deployed). Never commit real values.

# Which LLM backs the explain/flag/query agent: "workers-ai" (default, no key) or "meshapi"
AGENT_PROVIDER=workers-ai

# Only needed if AGENT_PROVIDER=meshapi
MESHAPI_API_KEY=
MESHAPI_BASE_URL=

# Optional sponsor adapter (only if a usable xSpan CareHub endpoint is wired)
XSPAN_API_KEY=
XSPAN_BASE_URL=
